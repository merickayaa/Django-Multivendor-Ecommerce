# Bu dosyayı .env adıyla kopyalayıp kendi değerlerinizi girin.
# Copy this file to .env and fill in your own values.

# --- Django ---
# Uzun ve rastgele bir anahtar / A long random key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Geliştirme ortamında True, canlıda False / True for development, False for production
IS_DEV=True

# Uygulamanın çalıştığı alan adı / Domain the app is served from
APP_HOST=localhost

# --- Veritabanı (MySQL) / Database (MySQL) ---
DB_HOST=
DB_NAME=
DB_PORT=
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# --- PayPal (Sandbox) ---
PAYPAL_EMAIL=your-sandbox-business@example.com

# --- AWS S3 (medya dosyaları / media files) ---
# S3 kullanmak için True yapın / Set to True to store media on S3
USE_S3=False
AWS_STORAGE_BUCKET_NAME=your-bucket-name
# Elastic Beanstalk dışında çalıştırırken (IAM rolü yoksa) gerekir
# Needed when running outside Elastic Beanstalk (no IAM role):
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
